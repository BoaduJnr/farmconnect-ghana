# Copy this file to .env (root) and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# ── Data stores (Docker Compose defaults — see infra/docker-compose.yml) ─────
DATABASE_URL=postgresql://farmconnect:farmconnect@localhost:5434/farmconnect
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
OTP_TTL_SECONDS=300

# ── AI Advisory Chatbot (Google Gemini — free tier, no credit card required) ─
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Weather (advisory chatbot context + weather alerts) ──────────────────────
# https://home.openweathermap.org/api_keys (free tier)
WEATHER_API_KEY=

# ── Outbound SMS (GiantSMS — OTP codes, order notifications, inbound-command replies) ────────
# https://giantsms.com/ — token is the ready-made "Authorization: Basic ..." value from your
# account (paste it as-is, do not re-encode); sender ID must be pre-registered with GiantSMS.
GIANTSMS_API_TOKEN=
GIANTSMS_SENDER_ID=

# ── Inbound SMS commands (sms-gateway module) ─────────────────────────────────
# No API key needed here — POST /api/sms/inbound is a public webhook. GiantSMS's API has no
# inbound/webhook support, so configure an inbound-capable provider (e.g. Africa's Talking,
# https://account.africastalking.com/) on ITS OWN dashboard to POST to this URL. Outbound SMS
# (above) and inbound SMS (this) can be, and here are, two different providers.

# Payments are NOT gateway-integrated — buyers pay the seller's registered Mobile Money
# number directly (see User.momoProvider/momoPhone/momoAccountName) and submit a
# transaction ID for the seller to confirm manually. No payment env vars needed.
